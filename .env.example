# Salin ke .env lalu isi. `npm start` memuat .env otomatis.
# Jangan pernah commit .env (sudah ada di .gitignore).

# --- server ---
PORT=3000
HOST=127.0.0.1
# development | production. Di production server menolak start bila konfigurasi tidak aman.
NODE_ENV=development
# Origin publik situs (wajib https:// di production). Dipakai untuk cek Origin + HSTS.
PUBLIC_ORIGIN=
# 1 bila di belakang reverse proxy (Caddy/nginx) yang mengisi X-Forwarded-For.
TRUST_PROXY=0
WA_NUMBER=6289698914005

# --- database (Supabase atau Neon) ---
# Kosongkan untuk pengembangan lokal: memakai PGlite di ./data/pglite.
# Neon:     postgresql://gibs_app:<sandi>@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb
# Supabase: postgresql://gibs_app.<project-ref>:<sandi>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Koneksi pemilik database untuk `npm run migrate` dan `npm run dsr`. Jangan dipakai server.
DATABASE_ADMIN_URL=
# Path sertifikat CA bila provider memakai CA sendiri (Supabase: unduh dari
# Project Settings > Database > SSL Configuration). Kosongkan untuk Neon.
DATABASE_CA_CERT=
# 1 = terapkan migrasi saat start. Default: 1 di development, 0 di production.
AUTO_MIGRATE=

# --- privasi & keamanan ---
# Kunci acak >= 32 karakter untuk meng-hash IP di log. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
# Masa simpan data pribadi RFQ sebelum dianonimkan (bulan).
RETENTION_MONTHS=24
# Kontak pelaporan celah keamanan untuk /.well-known/security.txt, mis. mailto:security@domain
SECURITY_CONTACT=
