{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "{GIBS Site.dc.html,support.js,assets/**,vendor/**,node_modules/{react,react-dom,gsap,lenis,@fontsource}/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
